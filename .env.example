DB_PORT=5432
DATABASE_URL=postgres://app:app@localhost:5432/app
API_PORT=3000
AI_URL=
AI_API_KEY=
AI_COLLECTION=
AI_SHOW_AUTHORS=false
# Panel administratora login (better-auth). Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production-0000
BETTER_AUTH_URL=http://localhost:5173
# The one predefined Pracownik ROPS account, created by `pnpm db:seed`.
ADMIN_EMAIL=admin@hubmi.local
ADMIN_PASSWORD=hubmi-admin-2026

# --- Kiosk (/kiosk) ---
# Baza adresu w kodzie QR „zabierz na telefon". MUSI być publicznie osiągalna
# z telefonu mieszkańca — localhost ani adres w LAN-ie nie zadziała, bo na telefonie
# `localhost` to sam telefon. Puste = wdrożona aplikacja (hackyeah2026.onrender.com),
# więc kod QR działa też wtedy, gdy kiosk chodzi lokalnie. Ustaw, jeśli wdrażasz gdzie indziej.
VITE_PUBLIC_URL=

# SMS z wynikiem z kiosku (HAC-21), przez textbee.dev: telefon z Androidem wysyła SMS-y ze swojej karty SIM.
# Klucz API i (opcjonalnie) ID urządzenia są w panelu textbee.dev. Bez klucza kiosk pokazuje „Nie udało się
# wysłać SMS-a" i kieruje do kodu QR. Link w SMS-ie bierze adres z VITE_PUBLIC_URL (jak kod QR).
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Limity publicznej wysyłki (puste = bez limitu). Darmowy plan textbee to 50 SMS-ów dziennie.
# SMS-y na 10 min z jednego IP / na jeden numer, i wszystkie SMS-y na dobę.
SMS_LIMIT_PER_IP=
SMS_LIMIT_PER_NUMBER=
SMS_DAILY_LIMIT=
