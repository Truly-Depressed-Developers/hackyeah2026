{
  "name": "hackathon-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "db:push": "pnpm --filter api db:push",
    "db:studio": "pnpm --filter api db:studio",
    "gen:ai": "pnpm --filter web gen:ai"
  },
  "devDependencies": {
    "oxlint": "^1.86.0",
    "turbo": "^2.11.5"
  }
}
