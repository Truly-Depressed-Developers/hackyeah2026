{
  "openapi": "3.0.3",
  "info": {
    "title": "HackYeah 2026 - Flask ChromaDB Vector API",
    "description": "Production-ready REST API for Chroma DB vector database with custom Google Gemini embeddings (gemini-embedding-2).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Health and system diagnostics"
    },
    {
      "name": "Collections",
      "description": "Chroma DB collection management"
    },
    {
      "name": "Documents",
      "description": "Document ingestion, retrieval, update, and deletion"
    },
    {
      "name": "Query",
      "description": "Semantic similarity vector search"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "API root info",
        "description": "Returns basic API metadata, active embedding model, and endpoint map.",
        "responses": {
          "200": {
            "description": "Service information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "description": "Checks Chroma DB connectivity, storage status, and Gemini API key readiness.",
        "responses": {
          "200": {
            "description": "System is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Service unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/collections": {
      "get": {
        "tags": [
          "Collections"
        ],
        "summary": "List all collections",
        "description": "Returns a list of all collections with metadata and record counts.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "API Authorization Key"
          }
        ],
        "responses": {
          "200": {
            "description": "List of collections",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Collections"
        ],
        "summary": "Create a new collection",
        "description": "Explicitly creates a collection with optional custom metadata.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCollectionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Collection created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SingleCollectionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid collection name or already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/collections/{collection_name}": {
      "get": {
        "tags": [
          "Collections"
        ],
        "summary": "Get collection details",
        "parameters": [
          {
            "name": "collection_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Name of the collection"
          },
          {
            "name": "api_key",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "API Authorization Key"
          }
        ],
        "responses": {
          "200": {
            "description": "Collection details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SingleCollectionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Collection not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Collections"
        ],
        "summary": "Delete a collection",
        "parameters": [
          {
            "name": "collection_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Name of the collection to delete"
          },
          {
            "name": "api_key",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "API Authorization Key"
          }
        ],
        "responses": {
          "200": {
            "description": "Collection deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessageResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error deleting collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Retrieve documents",
        "description": "Retrieve documents by comma-separated IDs or list with pagination.",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated IDs"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Max documents"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Pagination offset"
          },
          {
            "name": "collection_name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Target collection"
          },
          {
            "name": "api_key",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "API Key"
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieved documents",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDocumentsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Ingest new documents",
        "description": "Embeds and stores documents in the vector database.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDocumentsRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Documents added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentActionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Schema validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Documents"
        ],
        "summary": "Edit / update existing records",
        "description": "Updates text content, metadata, or both for existing document IDs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDocumentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Records updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentActionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Documents"
        ],
        "summary": "Delete documents",
        "description": "Deletes documents from the collection by ID.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteDocumentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Documents deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteDocumentsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/upsert": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Upsert documents",
        "description": "Inserts records if missing, or updates them if they already exist.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertDocumentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Documents upserted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentActionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/query": {
      "post": {
        "tags": [
          "Query"
        ],
        "summary": "Semantic vector search",
        "description": "Executes semantic similarity search against the vector database using Gemini embeddings.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Semantic query results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key in header (X-API-Key or Authorization: Bearer <key>), or in JSON payload as api_key"
      }
    },
    "schemas": {
      "RootInfoResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "embedding_model": {
            "type": "string"
          },
          "mock_mode": {
            "type": "boolean"
          },
          "docs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "status",
          "embedding_model"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "healthy"
          },
          "chroma_storage": {
            "type": "string",
            "example": "/app/chroma_data"
          },
          "embedding_model": {
            "type": "string",
            "example": "gemini-embedding-2"
          },
          "gemini_api_key_configured": {
            "type": "boolean",
            "example": true
          },
          "auth_enabled": {
            "type": "boolean",
            "example": true
          },
          "mock_embeddings_enabled": {
            "type": "boolean",
            "example": false
          },
          "collections_count": {
            "type": "integer",
            "example": 1
          }
        },
        "required": [
          "status",
          "chroma_storage",
          "embedding_model",
          "auth_enabled"
        ]
      },
      "CollectionItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "rops_innovations"
          },
          "count": {
            "type": "integer",
            "example": 115
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "name",
          "count"
        ]
      },
      "CollectionsResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "collections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectionItem"
            }
          }
        },
        "required": [
          "status",
          "collections"
        ]
      },
      "SingleCollectionResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string"
          },
          "collection": {
            "$ref": "#/components/schemas/CollectionItem"
          }
        },
        "required": [
          "status",
          "collection"
        ]
      },
      "QueryMatch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "dla-seniorow__bawita"
          },
          "document": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true
          },
          "distance": {
            "type": "number",
            "format": "float",
            "example": 0.3875,
            "nullable": true
          }
        },
        "required": [
          "id"
        ]
      },
      "QueryResultItem": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueryMatch"
            }
          }
        },
        "required": [
          "query",
          "matches"
        ]
      },
      "QueryResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "collection": {
            "type": "string",
            "example": "rops_innovations"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueryResultItem"
            }
          }
        },
        "required": [
          "status",
          "collection",
          "results"
        ]
      },
      "DocumentsData": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string",
              "nullable": true
            }
          },
          "metadatas": {
            "type": "array",
            "items": {
              "type": "object",
              "nullable": true
            }
          }
        },
        "required": [
          "ids"
        ]
      },
      "GetDocumentsResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "collection": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "data": {
            "$ref": "#/components/schemas/DocumentsData"
          }
        },
        "required": [
          "status",
          "collection",
          "data"
        ]
      },
      "DocumentActionResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "action": {
            "type": "string",
            "example": "upserted"
          },
          "collection": {
            "type": "string",
            "example": "rops_innovations"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "collection",
          "ids"
        ]
      },
      "DeleteDocumentsResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "collection": {
            "type": "string"
          },
          "deleted_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "collection",
          "deleted_ids"
        ]
      },
      "SuccessMessageResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Operation failed"
          }
        },
        "required": [
          "status",
          "message"
        ]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "status",
          "message"
        ]
      },
      "CreateCollectionRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique collection name (3-63 chars)"
          },
          "metadata": {
            "type": "object",
            "description": "Optional custom metadata dict"
          },
          "api_key": {
            "type": "string",
            "description": "API key if not using header auth"
          }
        }
      },
      "AddDocumentsRequest": {
        "type": "object",
        "required": [
          "documents"
        ],
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Document texts"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional IDs (auto-generated if omitted)"
          },
          "metadatas": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Optional metadata objects"
          },
          "collection_name": {
            "type": "string",
            "description": "Target collection name"
          },
          "api_key": {
            "type": "string",
            "description": "API key if not using header auth"
          }
        }
      },
      "UpdateDocumentsRequest": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Document IDs to update"
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Updated document texts"
          },
          "metadatas": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Updated metadata dicts"
          },
          "collection_name": {
            "type": "string",
            "description": "Target collection name"
          },
          "upsert": {
            "type": "boolean",
            "default": false
